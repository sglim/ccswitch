#!/usr/bin/env bash
# ccswitch SwiftBar/xbar plugin — show cached usage in the macOS menu bar.
#
# Install (one-time):
#   brew install --cask swiftbar       # or use xbar
#   open -a SwiftBar                   # creates ~/Library/Application Support/SwiftBar/Plugins/
#   ln -s "$HOME/.local/bin/ccswitch-statusbar" \
#         "$HOME/Library/Application Support/SwiftBar/Plugins/ccswitch.10s.sh"
#   # The "10s" suffix in the symlink filename = refresh interval. Adjust to taste.
#
# All data is read from $HOME/.claude-switch-backup/usage-cache/* with NO API
# calls, so even a 5-second refresh is free. The cache is filled by ccswitch.sh
# whenever it successfully fetches usage (manual or via LaunchAgent).

set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}"

readonly BACKUP_DIR="$HOME/.claude-switch-backup"
readonly SEQUENCE_FILE="$BACKUP_DIR/sequence.json"
readonly CACHE_DIR="$BACKUP_DIR/usage-cache"
readonly CCSWITCH_BIN="$HOME/.local/bin/ccswitch.sh"

# --tmux: tmux 상태줄용 한 줄만 찍는다(메뉴바 형식·드롭다운 없음). 캐시만 읽는다.
#   status-right 에 #(~/.local/bin/ccswitch-statusbar --tmux)
TMUX_MODE=0
[[ "${1:-}" == "--tmux" ]] && TMUX_MODE=1

if [[ ! -f "$SEQUENCE_FILE" ]]; then
    (( TMUX_MODE )) && exit 0
    echo "ccswitch ⛔️"
    echo "---"
    echo "ccswitch is not configured (no sequence.json) | color=#aaaaaa"
    exit 0
fi

# Resolve currently-active managed account by matching the live config's
# accountUuid + organizationUuid against sequence.json. Both fields are
# needed because the same accountUuid can appear under multiple orgs.
live_cfg=""
for p in "$HOME/.claude/.claude.json" "$HOME/.claude.json"; do
    if [[ -f "$p" ]] && jq -e '.oauthAccount' "$p" >/dev/null 2>&1; then
        live_cfg="$p"
        break
    fi
done

active_num=""
if [[ -n "$live_cfg" ]]; then
    live_uuid=$(jq -r '.oauthAccount.accountUuid // ""' "$live_cfg")
    live_org=$(jq -r '.oauthAccount.organizationUuid // ""' "$live_cfg")
    if [[ -n "$live_uuid" && -n "$live_org" ]]; then
        active_num=$(jq -r --arg uuid "$live_uuid" --arg ou "$live_org" '
            .accounts | to_entries[]
            | select(.value.uuid == $uuid and (.value.organizationUuid // "") == $ou)
            | .key' "$SEQUENCE_FILE" 2>/dev/null | head -n1)
    fi
fi

now=$(date +%s)

# 캐시 롤오버 보정. ccswitch.sh 의 gather_all_usage 와 같은 규칙이어야 한다.
#
# 캐시에 적힌 사용률은 "마지막 조회 시점" 값이라, 그 뒤 윈도우가 리셋됐으면
# 이미 무의미하다(대개 한도에 걸렸을 때의 100% 가 남아 있다). reset epoch 이
# 과거면 그 윈도우는 0 으로 본다.
#
# Fable 은 7d 와 같은 weekly 그룹이고 resets_at 이 동일하므로 7d 와 함께 되돌린다.
# 이 보정이 없어서 위젯이 CLI 와 다른 숫자를 보여줬다(2026-09: 위젯 59%/100%,
# 실제 API 0%/0%).
apply_rollover() {
    local five="$1" seven="$2" five_r="$3" seven_r="$4" fbl="$5" now="$6"
    [[ "$five_r" =~ ^[0-9]+$ ]] || five_r=0
    [[ "$seven_r" =~ ^[0-9]+$ ]] || seven_r=0
    if (( five_r > 0 && five_r <= now )); then
        five=0
    fi
    if (( seven_r > 0 && seven_r <= now )); then
        seven=0
        # 원래 숫자였던 경우에만 0 으로. -1(Fable 미지원)은 그대로 둔다.
        [[ "$fbl" =~ ^[0-9]+$ ]] && fbl=0
    fi
    printf '%s %s %s' "$five" "$seven" "$fbl"
}

# Format remaining-time seconds as a compact "Nd Nh" / "Nh Nm" / "Nm" string.
fmt_rem() {
    local rem="${1:-0}"
    if [[ -z "$rem" || "$rem" == "0" ]]; then echo "—"; return; fi
    if (( rem < 0 )); then echo "0m"; return; fi
    local d=$(( rem / 86400 ))
    local h=$(( (rem % 86400) / 3600 ))
    local m=$(( (rem % 3600) / 60 ))
    if (( d > 0 )); then printf '%dd%dh' "$d" "$h"
    elif (( h > 0 )); then printf '%dh%dm' "$h" "$m"
    else printf '%dm' "$m"
    fi
}

# Pick a status emoji by saturation level. Treats max(5h, 7d) as the signal.
sat_emoji() {
    local five="${1:-0}" seven="${2:-0}"
    [[ "$five" =~ ^[0-9]+$ ]] || five=0
    [[ "$seven" =~ ^[0-9]+$ ]] || seven=0
    local hi=$(( five > seven ? five : seven ))
    if (( hi >= 100 )); then echo "🔴"
    elif (( hi >= 80 )); then echo "🟡"
    else echo "🟢"
    fi
}

# ============ tmux 한 줄 ============
# 「#4 14%(4h21m) 80%(2h1m) · 전체 79%」 = 지금 계정 번호 · 5시간(초기화까지) · 주간(초기화까지) ·
# 등록된 모든 계정의 주간 사용률 평균(캐시가 있는 계정만, 지난 초기화는 0 으로 — 메뉴바와 같은 규칙).
# 지금 계정이 아닌 계정의 캐시는 그 계정을 마지막으로 조회한 때 값이다(다른 맥에서 쓴 만큼은 늦게 반영된다).
# 색은 claude-hud 의 사용량 색과 같은 기준: 75% 미만 파랑 · 75~89% 자주 · 90% 이상 빨강.
# HUD 의 「소모 속도(pace)」 경고는 넣지 않았다.
# 색값은 그릴 때마다 tmux 테마 옵션(catppuccin 의 @thm_fg·@thm_blue·@thm_mauve·@thm_red)에서 읽는다 —
# 테마를 바꾸면 따라간다. 숫자 뒤는 @thm_fg 로 되돌린다(#[fg=default] 는 칸의 글자색이 아니라
# 터미널 기본 글자색이 된다 — 2026-10-05 출력 코드로 확인). 옵션이 없으면 터미널 색 이름으로.
# 캐시가 5분 넘게 안 바뀌었으면(점검 에이전트가 멈춘 것) 끝에 「· N분 전」을 붙인다 — 조용히 옛 값을 보이지 않게.
if (( TMUX_MODE )); then
    cache="$CACHE_DIR/account-$active_num"
    [[ -n "$active_num" && -f "$cache" ]] || { echo "ccswitch ?"; exit 0; }
    read -r f s f_r s_r _ _ fbl < "$cache"
    read -r f s fbl <<< "$(apply_rollover "${f:-0}" "${s:-0}" "${f_r:-0}" "${s_r:-0}" "${fbl:-}" "$now")"
    read -r c_fg c_ok c_warn c_crit <<< "$(tmux display -p '#{@thm_fg} #{@thm_blue} #{@thm_mauve} #{@thm_red}' 2>/dev/null)" || true
    c_fg=${c_fg:-default} c_ok=${c_ok:-brightblue} c_warn=${c_warn:-brightmagenta} c_crit=${c_crit:-red}
    pct() {
        local v="$1"
        [[ "$v" =~ ^[0-9]+$ ]] || { printf '?%%'; return; }
        local c=$c_ok
        if (( v >= 90 )); then c=$c_crit
        elif (( v >= 75 )); then c=$c_warn
        fi
        printf '#[fg=%s]%s%%#[fg=%s]' "$c" "$v" "$c_fg"
    }
    # 막힘 위험 색(5시간·주간, 지금 계정): 이번 창에서 지금까지 쓴 속도(쓴 % ÷ 지난 시간)로 남은 시간 동안
    # 계속 쓰면 초기화 때 몇 % 가 되나 — 100% 이상(초기화 전에 막힘) 빨강 · 90~99% 자주(아슬아슬) · 그 밖 파랑.
    # 87%·7분 남음이면 4h53m 에 87% 를 썼으니 7분 동안 약 2% 더 → 89% → 파랑.
    # 창이 막 열려(10분 미만) 속도를 못 잴 때는 지금 % 로만(pct).
    risk() {
        local v="$1" r="$2" win="$3" c=$c_ok left gone proj
        [[ "$v" =~ ^[0-9]+$ && "$r" =~ ^[0-9]+$ ]] || { pct "$v"; return; }
        left=$(( r - now )) gone=$(( win - (r - now) ))
        (( left > 0 && gone >= 600 )) || { pct "$v"; return; }
        proj=$(( v + v * left / gone ))
        if (( v >= 100 || proj >= 100 )); then c=$c_crit
        elif (( proj >= 90 )); then c=$c_warn
        fi
        printf '#[fg=%s]%s%%#[fg=%s]' "$c" "$v" "$c_fg"
    }
    rem() {
        local r="${1:-0}"
        [[ "$r" =~ ^[0-9]+$ ]] && (( r > now )) && printf '(%s)' "$(fmt_rem $(( r - now )))"
        return 0
    }
    # 전체 = 모든 계정의 주간 사용률 평균. 계정마다 「번호:주간%:주간초기화」 를 모아 둔다(아래 속도 계산용).
    sum=0 n=0 cur="" mt_max=0 soon=0
    for num in $(jq -r '.accounts | keys[]' "$SEQUENCE_FILE"); do
        cf="$CACHE_DIR/account-$num"
        [[ -f "$cf" ]] || continue
        read -r af as af_r as_r _ _ afbl < "$cf"
        read -r af as afbl <<< "$(apply_rollover "${af:-0}" "${as:-0}" "${af_r:-0}" "${as_r:-0}" "${afbl:-}" "$now")"
        [[ "$as" =~ ^[0-9]+$ ]] || continue
        [[ "$as_r" =~ ^[0-9]+$ ]] || as_r=0
        sum=$(( sum + as )) n=$(( n + 1 )) cur="$cur $num:$as:$as_r"
        m=$(/usr/bin/stat -f %m "$cf" 2>/dev/null || /usr/bin/stat -c %Y "$cf" 2>/dev/null || echo 0)
        (( m > mt_max )) && mt_max=$m
        (( as_r > now && (soon == 0 || as_r < soon) )) && soon=$as_r
    done
    age=$(( now - $(/usr/bin/stat -f %m "$cache" 2>/dev/null || /usr/bin/stat -c %Y "$cache" 2>/dev/null || echo "$now") ))
    stale=""
    (( age > 300 )) && stale=" · $(( age / 60 ))분 전"

    # ---- 전체 소모 속도(최근 30분)와 고갈 예상 ----
    # 캐시는 계정마다 지금 값 하나뿐이라, 어느 계정 캐시든 새로 쓰일 때마다 기록(rate-all)에 한 줄 남긴다:
    #   <가장 최근 캐시 시각> <번호:주간%:주간초기화> ...   (최근 60줄만 둔다)
    # 30분 안에서 가장 오래된 줄과 지금을 계정별로 견줘 오른 만큼만 더한다 — 같은 주간 창(초기화 시각이 같은 것)끼리만,
    # 그래서 어느 계정이 초기화돼 0% 로 떨어져도 속도가 꺾이지 않는다. 합 ÷ 계정 수 = 「전체」 가 오른 만큼.
    # 기록이 10분이 안 되면 「–%/h」. 지금 계정은 매분, 나머지는 점검이 전체를 조회할 때(매시)만 갱신돼 값이 계단처럼 튄다.
    # 바닥 = 이 속도로 모든 계정의 주간 한도가 다 차기까지. 그게 가장 빠른 주간 초기화보다 먼저면(쓸 계정이 하나도
    # 없는 때가 온다) 「전체 N%」 를 빨강으로 칠하고 「8h40m 뒤 바닥」 을 붙인다. 아니면 파랑에 속도만.
    speed=""
    if (( n > 0 && mt_max > 0 )); then
        hist="$CACHE_DIR/rate-all"
        if [[ "$(tail -n 1 "$hist" 2>/dev/null | cut -d' ' -f1)" != "$mt_max" ]]; then
            { tail -n 59 "$hist" 2>/dev/null; echo "${mt_max}${cur}"; } > "$hist.tmp.$$" && mv "$hist.tmp.$$" "$hist"
        fi
        old=""
        while read -r t rest; do
            [[ "$t" =~ ^[0-9]+$ ]] || continue
            (( mt_max - t <= 1800 )) || continue
            old="$t $rest"
            break
        done < <(cat "$hist" 2>/dev/null)
        read -r old_t old_rest <<< "$old"
        if [[ -n "$old_t" ]] && (( mt_max - old_t >= 600 )); then
            span=$(( mt_max - old_t )) up=0
            for o in $old_rest; do
                IFS=: read -r on ov or <<< "$o"
                for c in $cur; do
                    IFS=: read -r cn cv cr <<< "$c"
                    [[ "$cn" == "$on" ]] || continue
                    (( cr - or < 600 && or - cr < 600 && cv > ov )) && up=$(( up + cv - ov ))
                done
            done
            # 전체 %/h, 소수 한 자리: up/n % 가 span 초 동안 올랐다.
            r10=$(( (up * 36000 * 2 + span * n) / (2 * span * n) ))
            speed=" $(( r10 / 10 )).$(( r10 % 10 ))%/h"
            pool_c=$c_ok
            if (( up > 0 && sum < n * 100 )); then
                eta=$(( (n * 100 - sum) * span / up ))
                if (( soon > now && eta < soon - now )); then
                    pool_c=$c_crit
                    speed="${speed} #[fg=${c_crit}]$(fmt_rem "$eta") 뒤 바닥#[fg=${c_fg}]"
                fi
            fi
        fi
    fi
    total=""
    if (( n > 0 )); then
        avg=$(( (sum + n / 2) / n ))
        if [[ -n "${pool_c:-}" ]]; then total=" · 전체 #[fg=${pool_c}]${avg}%#[fg=${c_fg}]${speed}"
        else total=" · 전체 $(pct "$avg")"
        fi
    fi

    echo "#${active_num} $(risk "$f" "$f_r" 18000)$(rem "$f_r") $(risk "$s" "$s_r" 604800)$(rem "$s_r")${total}${stale}"
    exit 0
fi

# ============ Menu-bar header (always one line) ============
if [[ -n "$active_num" && -f "$CACHE_DIR/account-$active_num" ]]; then
    read -r f s f_r s_r ext_en ext_u fbl < "$CACHE_DIR/account-$active_num"
    read -r f s fbl <<< "$(apply_rollover "${f:-0}" "${s:-0}" "${f_r:-0}" "${s_r:-0}" "${fbl:-}" "$now")"
    emoji=$(sat_emoji "$f" "$s")
    # Format: "🟢 #1  5h:5% 7d:1%  ext:0%"
    # Earlier compact "5/1" looked like a date (May 1). Labeling each
    # value with its window removes the date/ratio ambiguity.
    # Fable 은 별도 주간 한도라 메뉴바에도 같이 띄운다. -1/빈값은 미지원.
    if [[ "$fbl" =~ ^[0-9]+$ ]]; then fbl_hdr=" fable:${fbl}%"; else fbl_hdr=""; fi
    if [[ "$ext_en" == "true" && -n "$ext_u" ]]; then
        echo "${emoji} #${active_num}  5h:${f:-?}% 7d:${s:-?}%${fbl_hdr}  ext:${ext_u}%"
    else
        echo "${emoji} #${active_num}  5h:${f:-?}% 7d:${s:-?}%${fbl_hdr}"
    fi
elif [[ -n "$active_num" ]]; then
    echo "❓ ${active_num}: no cache"
else
    echo "❓ ccswitch"
fi

echo "---"

# ============ Dropdown ============
echo "ccswitch — cache only (no API call) | color=#888888 size=10"
echo "---"

# Column header
printf '%s\n' "  # Email                              5h%  5h-rst   7d%  7d-rst  Fable   Ext | font=Menlo size=11 trim=false"

# Per-account rows
nums=$(jq -r '.accounts | keys | map(tonumber) | sort | .[]' "$SEQUENCE_FILE")
while read -r num; do
    [[ -z "$num" ]] && continue
    email=$(jq -r --arg n "$num" '.accounts[$n].email // ""' "$SEQUENCE_FILE")
    [[ -z "$email" ]] && continue
    cache="$CACHE_DIR/account-$num"
    if [[ "$num" == "$active_num" ]]; then prefix="●"; else prefix=" "; fi

    if [[ -f "$cache" ]]; then
        # Cache may have 4 fields (legacy) or 6 fields. Trailing fields just
        # come back empty; that's fine.
        read -r five seven five_r seven_r ext_en ext_u fbl < "$cache"
        five_r=${five_r:-0}; seven_r=${seven_r:-0}
        read -r five seven fbl <<< "$(apply_rollover "${five:-0}" "${seven:-0}" "$five_r" "$seven_r" "${fbl:-}" "$now")"
        five_rem=$(( five_r > now ? five_r - now : 0 ))
        seven_rem=$(( seven_r > now ? seven_r - now : 0 ))
        if [[ "$ext_en" == "true" ]]; then
            if [[ "$ext_u" =~ ^[0-9]+$ ]]; then
                ext_disp="${ext_u}%"
            else
                ext_disp="yes"
            fi
        else
            ext_disp="—"
        fi
        # Fable handicap 이 걸려 있으면 CLI 와 같이 "53+100" 형태로. 왜 후순위인지
        # 위젯만 봐도 알 수 있게 한다. handicap 은 캐시에 없어 sequence.json 에서 읽는다.
        fbl_hc=$(jq -r --arg n "$num" '.accounts[$n].fableHandicap // 0' "$SEQUENCE_FILE" 2>/dev/null)
        if [[ "$fbl" =~ ^[0-9]+$ ]]; then
            if [[ "$fbl_hc" =~ ^[0-9]+$ ]] && (( fbl_hc > 0 )); then
                fbl_disp="${fbl}+${fbl_hc}"
            else
                fbl_disp="${fbl}%"
            fi
        else
            fbl_disp="—"
        fi
        line=$(printf '%s %2s %-32s %3s%%  %-6s  %3s%%  %-6s  %5s  %s' \
            "$prefix" "$num" "${email:0:32}" \
            "${five:-0}" "$(fmt_rem "$five_rem")" \
            "${seven:-0}" "$(fmt_rem "$seven_rem")" \
            "$fbl_disp" "$ext_disp")
    else
        line=$(printf '%s %2s %-32s   (no cache yet)' "$prefix" "$num" "${email:0:32}")
    fi
    # Make each non-active row a click target that switches to that
    # account. terminal=false runs it silently; ccswitch posts its own
    # macOS notification on success, and refresh=true repaints the
    # widget so the ● moves. The active row gets no action (switching
    # to the current account is a no-op).
    if [[ "$num" == "$active_num" ]]; then
        printf '%s | font=Menlo size=11 trim=false\n' "$line"
    else
        printf '%s | font=Menlo size=11 trim=false shell='"'"'%s'"'"' param1='"'"'--switch-to'"'"' param2='"'"'%s'"'"' terminal=false refresh=true\n' \
            "$line" "$CCSWITCH_BIN" "$num"
    fi
done <<< "$nums"

echo "---"
echo "Show usage (live, hits API) | shell='$CCSWITCH_BIN' param1='--show-usage' terminal=true"
echo "Switch lowest | shell='$CCSWITCH_BIN' param1='--switch-lowest' terminal=true"
echo "Refresh now | refresh=true"
